# The working handoff note: ephemeral by design and rewritten each time.
START_HERE.md

# Scratch space. Working files live here and not in /tmp, so they are beside
# the work and go when the repository does.
.ephemera/

.bolt*/
# `.coverage` is the combined data file and `.coverage.*` are the per-process
# ones `coverage run --parallel-mode` writes: one per test process and one per
# spawned checker, so a run leaves dozens. The jig combines them before
# reporting, but a run that fails before `coverage combine` leaves them behind,
# and a pattern matching only the combined name left 65 of them showing as
# untracked after one such run.
.coverage
.coverage.*
coverage.xml

# The uv environment the jig's `tests` task runs in.
.venv/
__pycache__/
.mypy_cache/
.ruff_cache/
