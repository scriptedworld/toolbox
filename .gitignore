# Session entry point: ephemeral by design, rewritten each session.
START_HERE.md

# Session scratch. Working files live here rather than in /tmp, so they are
# beside the work and go when the repository does.
.ephemera/

.bolt*/
# `.coverage` is the combined data file and `.coverage.*` are the per-process
# ones `coverage run --parallel-mode` writes: one per test process and one per
# spawned checker, so a run leaves dozens. The jig combines them before
# reporting, but a run that fails before `coverage combine` leaves them behind,
# and a pattern that matched only the combined name let 65 of them show up as
# untracked. Measured 2026-09-04.
.coverage
.coverage.*
coverage.xml

# The uv environment the jig's `tests` task runs in.
.venv/
__pycache__/
.mypy_cache/
.ruff_cache/
